@"
APP_ENV=development
DATABASE_URL=sqlite:///./calles_seguras.db
# Ejemplo para PostgreSQL en Docker Compose / produccion:
# DATABASE_URL=postgresql://calles_user:calles_password@db:5432/calles_seguras

SECRET_KEY=cambia-esta-clave-secreta-en-produccion
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://mochaikin.github.io
EXTERNAL_WEATHER_API=https://api.open-meteo.com/v1/forecast
"@ | Set-Content -Path ".env.example" -Encoding UTF8

New-Item -ItemType Directory -Force -Path ".github\workflows" | Out-Null

@"
name: CI - Calles Seguras Juarez

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  test-backend:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout del repositorio
        uses: actions/checkout@v4

      - name: Configurar Python 3.13
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Instalar dependencias
        run: |
          python -m pip install --upgrade pip
          pip install -r backend/requirements.txt
          pip install pytest httpx

      - name: Ejecutar pruebas automatizadas con pytest
        run: |
          python -m pytest -v
"@ | Set-Content -Path ".github\workflows\ci.yml" -Encoding UTF8